# Ruta Traefik para una instalación sin panel web ni ForwardAuth.
# La API continúa protegida por HTTPS y tokens Bearer independientes.
http:
  middlewares:
    save-sync-__SAVE_SYNC_GAME_KEY__-clear-untrusted-auth:
      headers:
        customRequestHeaders:
          X-authentik-username: ""
          X-authentik-groups: ""
          X-authentik-entitlements: ""
          X-authentik-email: ""
          X-authentik-name: ""
          X-authentik-uid: ""
          X-authentik-jwt: ""
          X-Save-Sync-Proxy-Secret: ""

    save-sync-__SAVE_SYNC_GAME_KEY__-security-headers:
      headers:
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: "no-referrer"
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        customResponseHeaders:
          Cache-Control: "private, no-store"

    save-sync-__SAVE_SYNC_GAME_KEY__-api-rate-limit:
      rateLimit:
        average: 120
        period: 1m
        burst: 30

  routers:
    save-sync-__SAVE_SYNC_GAME_KEY__-api:
      rule: "Host(`__SAVE_SYNC_PUBLIC_HOST__`) && (Path(`/api/games/__SAVE_SYNC_GAME_KEY__`) || PathPrefix(`/api/games/__SAVE_SYNC_GAME_KEY__/`))"
      priority: 2200
      entryPoints:
        - websecure
      tls:
        certResolver: __SAVE_SYNC_CERT_RESOLVER__
      middlewares:
        - save-sync-__SAVE_SYNC_GAME_KEY__-clear-untrusted-auth
        - save-sync-__SAVE_SYNC_GAME_KEY__-security-headers
        - save-sync-__SAVE_SYNC_GAME_KEY__-api-rate-limit
      service: save-sync-__SAVE_SYNC_GAME_KEY__-backend

  services:
    save-sync-__SAVE_SYNC_GAME_KEY__-backend:
      loadBalancer:
        servers:
          - url: "http://save-sync-__SAVE_SYNC_GAME_KEY__:8080"
        healthCheck:
          path: /healthz
          interval: 10s
          timeout: 3s
