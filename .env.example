SAVE_SYNC_GAME_KEY=palworld
SAVE_SYNC_GAME_CONFIG_PATH=/app/game.json
SAVE_SYNC_CONTAINER_NAME=save_sync_palworld
SAVE_SYNC_BACKUP_CONTAINER_NAME=save_sync_palworld_backup
SAVE_SYNC_HOST_STORAGE_PATH=/srv/save-sync/palworld
SAVE_SYNC_STORAGE_PATH=/data/save-sync
SAVE_SYNC_DB_PATH=/data/save-sync/save-sync.sqlite3
SAVE_SYNC_PUBLIC_HOST=sync.example.com
SAVE_SYNC_PUBLIC_BASE_URL=https://sync.example.com
SAVE_SYNC_PUBLIC_ROOT=/var/www/html
SAVE_SYNC_TRAEFIK_DYNAMIC_DIR=/etc/traefik/dynamic
SAVE_SYNC_PROXY_NETWORK=traefik_proxy
SAVE_SYNC_AUTHENTIK_FORWARD_AUTH_URL=http://authentik-proxy:9000/outpost.goauthentik.io/auth/traefik
SAVE_SYNC_PANEL_MODE=authentik
SAVE_SYNC_TRAEFIK_CERT_RESOLVER=myresolver
SAVE_SYNC_MAX_UPLOAD_SIZE=1073741824
SAVE_SYNC_LOCK_TTL_SECONDS=300
SAVE_SYNC_HEARTBEAT_INTERVAL_SECONDS=60
SAVE_SYNC_MAX_ZIP_ENTRIES=20000
SAVE_SYNC_MAX_UNCOMPRESSED_SIZE=10737418240
SAVE_SYNC_MAX_COMPRESSION_RATIO=200
SAVE_SYNC_RATE_LIMIT_PER_MINUTE=120
SAVE_SYNC_WEB_USERS=admin:admin,player:player
SAVE_SYNC_USER_IDENTITIES_JSON={"admin":{"displayName":"Host A","slot":"host-a"},"player":{"displayName":"Host B","slot":"host-b"}}
# Number of recent versions to keep per slot (default 1).
# A version with a pending backup stays protected until the supervisor resolves it.
# SAVE_SYNC_RETENTION_PER_SLOT=5
# External command consumed by the durable backup-supervisor sidecar after each
# confirmed publication. The container includes restic 0.18.0 pinned by SHA-256;
# Configure RESTIC_REPOSITORY/RESTIC_PASSWORD. temporary/ is excluded from the backup.
# SAVE_SYNC_POST_PUBLISH_COMMAND=restic backup /data/save-sync --exclude /data/save-sync/temporary
# Maximum timeout for each backup attempt (default 1800s/30m).
# SAVE_SYNC_POST_PUBLISH_TIMEOUT_SECONDS=1800
# SQLite backup-queue polling frequency (default 1s).
# SAVE_SYNC_BACKUP_POLL_SECONDS=1
# Must be long, random and match the header injected by the proxy.
SAVE_SYNC_PROXY_SECRET=REPLACE_IN_DEPLOYMENT
# Independent secret used to sign deterministic panel CSRF tokens.
SAVE_SYNC_CSRF_SECRET=REPLACE_IN_DEPLOYMENT
# Optional, bootstrap only. Only the token hash is persisted.
# SAVE_SYNC_BOOTSTRAP_TOKENS_JSON=[{"username":"admin","name":"pc-admin","token":"pws_REPLACE"}]